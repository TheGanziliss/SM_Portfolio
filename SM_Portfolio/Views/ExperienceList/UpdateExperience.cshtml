@model Experience

@{
	ViewData["Title"] = "UpdateExperience";
	Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Tables</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Basic Table</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							This is the basic table view of the ready dashboard :
						</div>

						<form method="post">
							<input type="hidden" asp-for="ExperienceId" />
							<label>Company Detail</label>
							<input type="text" asp-for="Head" class="form-control" />
							<br />
							<label>Personal Title</label>
							<input type="text" asp-for="Title" class="form-control" />
							<br />
							<label>Experience Date</label>
							<input type="text" asp-for="Date" class="form-control" />
							<br />
							<label>Details</label>
							<textarea rows="4" class="form-control" asp-for="Description"></textarea>
							<br />
							<button class="btn btn-primary">Update Experience</button>
						</form>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>